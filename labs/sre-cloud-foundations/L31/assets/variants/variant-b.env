# Colleague's draft: 'reuse the database Secret we already have, no need to generate one'.
# L31 release configuration: the ONLY input rebuild.sh reads. KEY=VALUE, no quotes, no spaces.
# Unknown keys are refused. Paths are relative to the repository root and must be checked in.
NAMESPACE=beacon-rebuild
CLUSTER=looped-policy
ENVIRONMENT=prod
RELEASE=beacon
IMAGE_REPO=looped-l31-beacon
IMAGE_TAG=1.4.0
IMAGE_SOURCE=build
DB_SECRET_SOURCE=existing:beacon-db-auth
SEED_RECORDS=240
CHART=labs/sre-cloud-foundations/L19/chart
CHART_VERSION=0.4.0
POSTGRES_IMAGE=postgres:16.4@sha256:e62fbf9d3e2b49816a32c400ed2dba83e3b361e6833e624024309c35d334b412
REDIS_IMAGE=redis:7.4.1-alpine@sha256:c1e88455c85225310bbea54816e9c3f4b5295815e6dbf80c34d40afc6df28275
PROMTOOL_IMAGE=prom/prometheus:v3.5.0
SLO_DIR=labs/sre-cloud-foundations/L31/release/slo
DASHBOARD=labs/sre-cloud-foundations/L31/release/dashboard.json
