# Server limits for every api replica (read at container start: after editing,
# `docker compose -p looped-l27 -f work/compose.yaml up -d` recreates the replicas).
# See assets/ingest.py for what each knob does.
WORKERS=16
QUEUE_MAX=0
QUEUE_TIMEOUT_MS=0
POOL_SIZE=16
RETRY_AFTER_S=1
WRITE_PATH=hot-row
# fixture: the simulated cost of one write inside its transaction; leave at 25
WRITE_COST_MS=25
