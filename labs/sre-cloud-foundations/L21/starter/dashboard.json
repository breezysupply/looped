{
  "uid": "looped-l21-beacon",
  "title": "Beacon L21 \u2014 RED and USE",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(beacon_l21_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(beacon_l21_requests_total{status_class=\"5xx\"}[1m]) or 0 * rate(beacon_l21_requests_total[1m])) / sum(rate(beacon_l21_requests_total[1m]))"
        }
      ]
    }
  ]
}