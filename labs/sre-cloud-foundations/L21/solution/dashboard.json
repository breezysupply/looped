{
  "uid": "looped-l21-beacon",
  "title": "Beacon L21 \u2014 RED and USE",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(beacon_l21_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(beacon_l21_requests_total{status_class=\"5xx\"}[1m])) / sum(rate(beacon_l21_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency /sensors",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(beacon_l21_request_duration_seconds_bucket{route=\"/sensors/{id}\"}[1m])))",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency p95",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(beacon_l21_dependency_duration_seconds_bucket{dependency=\"registry\"}[1m])))",
          "exemplar": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API CPU",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "looped-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"beacon-l21-api\"}[1m])",
          "exemplar": true
        }
      ]
    }
  ]
}