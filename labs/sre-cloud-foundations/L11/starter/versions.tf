# L11 — Beacon configuration generated by Terraform with two local-only
# providers. No cloud, no backend block: state is the local file
# terraform.tfstate in this directory (the lab guard refuses anything else).
terraform {
  required_version = ">= 1.9.0" # cross-variable validation and `terraform test`

  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "2.9.1"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
  }
}
