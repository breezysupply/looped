# Generated by Terraform (L11) for environment ${environment}. Do not edit by
# hand: change the variables and apply. Validate with
#   python3 -m beacon validate-config --config <this file>
server:
  listen: 0.0.0.0
  port: ${listen_port}
app:
  version: "${app_version}"
  environment: ${environment}
  admin_enabled: ${admin_enabled}
store:
  kind: ${store_kind}
%{ if store_kind == "sqlite" ~}
  path: ${store_path}
%{ endif ~}
queue:
  kind: none
inject:
  delay_ms: 0
  fail_rate: 0.0
  ready_fail: false
