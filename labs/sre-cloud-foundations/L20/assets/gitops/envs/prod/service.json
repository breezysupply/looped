{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "beacon-prod",
    "namespace": "beacon",
    "labels": {
      "app": "beacon",
      "env": "prod",
      "looped.lab/id": "L20"
    }
  },
  "spec": {
    "selector": {
      "app": "beacon",
      "env": "prod"
    },
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "targetPort": "http"
      }
    ]
  }
}
